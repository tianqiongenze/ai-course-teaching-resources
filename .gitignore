# 系统与编辑器
.DS_Store
Thumbs.db
.idea/

# 大型中间产物（若需提交请显式 git add -f）
*.tmp
*.bak
*.bak*
# pytest 在仓库内实跑时的临时输出目录（run.py 的 output/ 才是交付证据）
*/工程化项目/*/output/test_run/

